<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<!--
		A PackageReference on purpose, not a ProjectReference. What is under test is the
		package: whether it carries a TracyClient library for each runtime identifier and
		whether the host process finds and loads it from runtimes/. A project reference
		bypasses that layout entirely and would pass against a package shipping nothing.
	-->
	<ItemGroup>
		<PackageReference Include="Evergine.Bindings.Tracy" Version="$(TracyVersion)" />
	</ItemGroup>

</Project>
