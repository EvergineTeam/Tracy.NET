<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!--
			net10.0-windows, not the plain net10.0 the rest of the repository uses: Evergine.Forms
			only ships lib/net10.0-windows7.0 and declares a framework reference on
			Microsoft.WindowsDesktop.App.WindowsForms. The binding targets plain net10.0, so
			referencing it from here is fine: the dependency only points one way.
		-->
		<TargetFramework>net10.0-windows</TargetFramework>
		<OutputType>WinExe</OutputType>
		<UseWindowsForms>true</UseWindowsForms>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>false</SelfContained>
		<Nullable>disable</Nullable>
	</PropertyGroup>

	<!--
		A ProjectReference, unlike SmokeTest: this sample exists to exercise the *source* of the
		binding against a real GPU, not the layout of the .nupkg, and requiring a dotnet pack
		before every run would make that loop useless.
	-->
	<ItemGroup>
		<ProjectReference Include="..\Evergine.Bindings.Tracy\Evergine.Bindings.Tracy.csproj" />
	</ItemGroup>

	<!--
		The load-bearing line. The binding project publishes its natives as
		Content Include="runtimes\**", which through a ProjectReference lands in
		bin\...\runtimes\win-x64\native\TracyClient.dll, a path nothing probes. Only NuGet
		resolves runtimes/<rid>/native, through the deps.json a PackageReference produces.
		So drop a copy next to the executable, where DllImport("TracyClient") does look;
		without it the first Profiler call dies with DllNotFoundException.
	-->
	<ItemGroup>
		<Content Include="..\Evergine.Bindings.Tracy\runtimes\win-x64\native\TracyClient.dll">
			<Link>TracyClient.dll</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<!--
		Two ways to get Evergine, selected by EvergineSourceRoot (an MSBuild property, which
		also means an environment variable of that name): point it at the `src` folder of an
		Engine checkout and the five projects are built from source; leave it empty and the
		packages named by EvergineVersion are used.

		The sample needs Fence and CommandQueue.GetClockCalibration, which no released package
		carries yet. Until one does, either build from source or install the packages a pull
		request build produced and pass that version on the command line:

			-p:EvergineVersion=2026.9.9.1243-pr591

		The pull request version carries the minute of the day, so every CI run produces a new
		one. That is why it is not pinned here. Bump EvergineVersion and delete these two
		paragraphs once a released package carries the API.
	-->
	<PropertyGroup>
		<UseEvergineSources>false</UseEvergineSources>
		<UseEvergineSources Condition="'$(EvergineSourceRoot)' != ''">true</UseEvergineSources>
		<EvergineVersion>2026.5.26.921</EvergineVersion>
	</PropertyGroup>

	<ItemGroup Condition="$(UseEvergineSources)">
		<ProjectReference Include="$(EvergineSourceRoot)\Engine\Common\Evergine.Mathematics\Evergine.Mathematics.csproj" />
		<ProjectReference Include="$(EvergineSourceRoot)\Engine\Common\Evergine.Common\Evergine.Common.csproj" />
		<ProjectReference Include="$(EvergineSourceRoot)\Engine\Rendering\Evergine.DirectX12\Evergine.DirectX12.csproj" />
		<ProjectReference Include="$(EvergineSourceRoot)\Engine\Rendering\Evergine.Vulkan\Evergine.Vulkan.csproj" />
		<ProjectReference Include="$(EvergineSourceRoot)\Engine\WindowSystems\Evergine.Forms\Evergine.Forms.csproj" />
	</ItemGroup>

	<!--
		Pinned to one version for all five packages: mismatched Evergine versions do not compose,
		and Evergine.DirectX12 tends to lag the others by a build.
	-->
	<ItemGroup Condition="!$(UseEvergineSources)">
		<PackageReference Include="Evergine.Common" Version="$(EvergineVersion)" />
		<PackageReference Include="Evergine.Mathematics" Version="$(EvergineVersion)" />
		<PackageReference Include="Evergine.DirectX12" Version="$(EvergineVersion)" />
		<PackageReference Include="Evergine.Vulkan" Version="$(EvergineVersion)" />
		<PackageReference Include="Evergine.Forms" Version="$(EvergineVersion)" />
	</ItemGroup>

	<Target Name="CheckEvergineSourceRoot" BeforeTargets="Restore;CollectPackageReferences;Build" Condition="$(UseEvergineSources) And !Exists('$(EvergineSourceRoot)\Engine\Common\Evergine.Common\Evergine.Common.csproj')">
		<Error Text="EvergineSourceRoot is '$(EvergineSourceRoot)' but '$(EvergineSourceRoot)\Engine\Common\Evergine.Common\Evergine.Common.csproj' does not exist. Point it at the src folder of an Evergine Engine checkout." />
	</Target>

</Project>
